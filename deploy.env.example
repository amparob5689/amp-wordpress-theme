# Copy to deploy.env (gitignored) and fill in. Never commit deploy.env.
# Values are in the Cloudways dashboard: Servers > Master Credentials, and
# Applications > Access Details.
DEPLOY_HOST=
DEPLOY_USER=
# Absolute path to the theme directory on the server, with trailing slash, e.g.
# /home/master/applications/<app-folder>/public_html/wp-content/themes/amp-theme/
DEPLOY_PATH=
# Optional: path to the private key registered in Cloudways
# DEPLOY_SSH_KEY=~/.ssh/id_ed25519
